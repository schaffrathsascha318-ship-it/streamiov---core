# Example only. Replace the domain and certificate paths with values owned by
# the operator. Do not install until public auth/data routes have been reviewed.

server {
    listen 80;
    server_name streamiov.example.invalid;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name streamiov.example.invalid;

    ssl_certificate     /etc/ssl/streamiov/fullchain.pem;
    ssl_certificate_key /etc/ssl/streamiov/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    client_max_body_size 16k;

    location / {
        proxy_pass http://127.0.0.1:8765;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        # Overwrite these values: the app trusts them only from loopback.
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Connection "";
    }
}

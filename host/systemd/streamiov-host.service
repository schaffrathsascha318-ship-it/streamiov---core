[Unit]
Description=StreamioV local account host bootstrap
After=network.target

[Service]
Type=simple
User=streamiov
Group=streamiov
WorkingDirectory=/opt/streamiov
StateDirectory=streamiov-host streamiov
StateDirectoryMode=0700
Environment=STREAMIOV_TASK_QUEUE_DB=/var/lib/streamiov/queue.sqlite3
Environment=STREAMIOV_QUEUE_ADMIN_USER_IDS_FILE=/etc/streamiov/queue-admin-user-ids
ExecStart=/usr/bin/python3 /opt/streamiov/host/server.py --host 127.0.0.1 --port 8765 --site-root /opt/streamiov/dist/streamiov-homepage-worker/public --data-dir /var/lib/streamiov-host --trust-loopback-proxy
Restart=on-failure
RestartSec=3
TimeoutStopSec=10
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ReadWritePaths=/var/lib/streamiov
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryMax=128M
TasksMax=32
UMask=0077

[Install]
WantedBy=multi-user.target

{
  "name": "streamiov-studio",
  "version": "1.0.4",
  "description": "Streamiov Studio",
  "homepage": "https://streamiov.pages.dev/",
  "author": {
    "name": "Streamiov",
    "email": "schaffrathsascha318@gmail.com"
  },
  "main": "main.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "electron .",
    "test:engine": "node --test engine/*.test.js",
    "build:update-manifest": "node ../../scripts/build-studio-update-manifest.mjs",
    "prestart": "python3 ../../scripts/sync-studio-tiktok-oauth.py",
    "dist:win": "electron-builder --win nsis --x64",
    "dist:win:arm64": "electron-builder --win nsis --arm64",
    "dist:linux": "electron-builder --linux AppImage deb --x64",
    "dist:linux:arm64": "electron-builder --linux AppImage deb --arm64",
    "dist:chromeos:arm64": "electron-builder --linux deb --arm64",
    "dist:chromeos:x64": "electron-builder --linux deb --x64",
    "dist:mac:x64": "electron-builder --mac dmg --x64",
    "dist:mac:arm64": "electron-builder --mac dmg --arm64",
    "predist:win": "python3 ../../scripts/sync-studio-tiktok-oauth.py",
    "predist:win:arm64": "python3 ../../scripts/sync-studio-tiktok-oauth.py",
    "predist:linux": "python3 ../../scripts/sync-studio-tiktok-oauth.py",
    "predist:linux:arm64": "python3 ../../scripts/sync-studio-tiktok-oauth.py",
    "predist:chromeos:arm64": "python3 ../../scripts/sync-studio-tiktok-oauth.py",
    "predist:chromeos:x64": "python3 ../../scripts/sync-studio-tiktok-oauth.py",
    "predist:mac:x64": "python3 ../../scripts/sync-studio-tiktok-oauth.py",
    "predist:mac:arm64": "python3 ../../scripts/sync-studio-tiktok-oauth.py"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "tv.streamiov.studio",
    "productName": "Streamiov Studio",
    "directories": {
      "output": "release"
    },
    "files": [
      "**/*",
      "!backup-tiktok-*/**/*",
      "!**/*.log",
      "!**/.env*",
      "!games/**",
      "!**/data/**",
      "!release/**",
      "!squashfs-root/**",
      "!index-before-*.html",
      "!**/*.bak",
      "!**/*.bak-*",
      "!**/*.backup*",
      "!**/*.save",
      "!**/*.save.*",
      "!**/*.before-*",
      "!**/__pycache__/**",
      "!**/*.pyc",
      "!ffmpeg/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "linux": {
      "category": "AudioVideo",
      "maintainer": "Streamiov <schaffrathsascha318@gmail.com>",
      "target": [
        "AppImage",
        "deb"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "extraResources": []
    },
    "extraResources": [
      {
        "from": "ffmpeg",
        "to": "ffmpeg",
        "filter": [
          "**/*"
        ]
      }
    ]
  }
}

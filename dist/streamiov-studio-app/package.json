{
  "name": "streamiov-studio",
  "version": "1.0.0",
  "description": "Streamiov Studio",
  "homepage": "https://streamiov.pages.dev/",
  "author": {
    "name": "Streamiov",
    "email": "schaffrathsascha318@gmail.com"
  },
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis --x64",
    "dist:linux": "electron-builder --linux AppImage deb --x64",
    "dist:linux:arm64": "electron-builder --linux AppImage deb --arm64",
    "prestart": "python3 ../../scripts/sync-studio-ui.py && python3 ../../scripts/sync-studio-games.py",
    "test:engine": "node --test engine/*.test.js",
    "dist:win:arm64": "electron-builder --win nsis --arm64",
    "predist:win": "python3 ../../scripts/sync-studio-ui.py && python3 ../../scripts/sync-studio-games.py",
    "predist:win:arm64": "python3 ../../scripts/sync-studio-ui.py && python3 ../../scripts/sync-studio-games.py",
    "predist:linux": "python3 ../../scripts/sync-studio-ui.py && python3 ../../scripts/sync-studio-games.py",
    "predist:linux:arm64": "python3 ../../scripts/sync-studio-ui.py && python3 ../../scripts/sync-studio-games.py"
  },
  "dependencies": {
    "tiktok-live-connector": "2.5.0"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "tv.streamiov.studio",
    "productName": "Streamiov Studio",
    "directories": {
      "output": "release"
    },
    "files": [
      "**/*",
      "!backup-tiktok-*/**/*",
      "!**/*.log",
      "!**/.env*",
      "!**/data/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "category": "AudioVideo",
      "maintainer": "Streamiov <schaffrathsascha318@gmail.com>",
      "target": [
        "AppImage",
        "deb"
      ]
    }
  }
}

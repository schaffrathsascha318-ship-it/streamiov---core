# Copy to /etc/streamiov/ai-chief.env; replace every placeholder.
# This example uses the existing Streamiov AI Worker. Keep the token private.
STREAMIOV_PROJECT_GOAL="Finish and integrate the existing Streamiov project; prioritize the persistent AI Chief, Core, Studio/Regie, audio, chat/TTS, games/gifts, and homepage/downloads. Continue with the next open task after each completed mission. Preserve user data, secrets, security boundaries, backups, and rollback safety. Do not claim unverified work is production-ready."
STREAMIOV_MODEL_PROVIDER=cloudflare-workers-ai
STREAMIOV_MODEL=@cf/zai-org/glm-4.7-flash
STREAMIOV_MODEL_URL=https://REPLACE_WITH_EXISTING_STREAMIOV_AI_WORKER.workers.dev
STREAMIOV_AI_WORKER_TOKEN=REPLACE_WITH_PRIVATE_AI_WORKER_TOKEN

# For local Ollama instead, use:
# STREAMIOV_MODEL_PROVIDER=ollama
# STREAMIOV_MODEL=qwen2.5-coder:7b
# STREAMIOV_MODEL_URL=http://127.0.0.1:11434
# Remove STREAMIOV_AI_WORKER_TOKEN when using the local provider.

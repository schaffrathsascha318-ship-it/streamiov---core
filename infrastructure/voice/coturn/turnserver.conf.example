# Copy to /etc/turnserver.conf and replace every REPLACE_* value.
# Protect the resulting file: root:turnserver, mode 0600.
listening-port=3478
tls-listening-port=5349
fingerprint
use-auth-secret
static-auth-secret=REPLACE_WITH_THE_SAME_RANDOM_SECRET_AS_STREAMIOV_TURN_SHARED_SECRET
realm=REPLACE_WITH_VOICE_DOMAIN
server-name=REPLACE_WITH_VOICE_DOMAIN
cert=/etc/letsencrypt/live/REPLACE_WITH_VOICE_DOMAIN/fullchain.pem
pkey=/etc/letsencrypt/live/REPLACE_WITH_VOICE_DOMAIN/privkey.pem

# Restrict the UDP relay range and open these ports in the host firewall.
min-port=49160
max-port=49200

# If the host is behind NAT, set its public address and private relay address:
# external-ip=PUBLIC_IPV4/PRIVATE_IPV4

no-cli
no-multicast-peers
no-loopback-peers
stale-nonce
no-tlsv1
no-tlsv1_1
user-quota=8
total-quota=64
max-bps=500000
bps-capacity=1000000
simple-log

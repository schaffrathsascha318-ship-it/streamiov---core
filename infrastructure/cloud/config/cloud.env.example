# Streamiov Production Cloud
# Niemals echte Secrets hier eintragen.

STREAMIOV_ENV=production

STREAMIOV_HOST=127.0.0.1
STREAMIOV_PORT=8080

STREAMIOV_GATEWAY_HOST=127.0.0.1
STREAMIOV_GATEWAY_PORT=8090

STREAMIOV_BACKEND=http://127.0.0.1:8080

STREAMIOV_DATA_DIR=/var/lib/streamiov
STREAMIOV_BACKUP_DIR=/var/backups/streamiov
STREAMIOV_LOG_DIR=/var/log/streamiov

STREAMIOV_TLS_ENABLED=true

# Für den ersten Deployment-Schritt leer lassen.
STREAMIOV_PUBLIC_HOST=

# Produktions-Cookies dürfen nur über HTTPS gesendet werden.
STREAMIOV_COOKIE_SECURE=true

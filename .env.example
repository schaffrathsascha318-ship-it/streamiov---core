# Copy to .env and configure at least one reachable model provider.
# Do not commit .env or place real tokens in this example file.

# Provider options: ollama | openai-compatible-local | cloudflare-workers-ai
OPENCODE_MODEL_PROVIDER=ollama
OPENCODE_MODEL=qwen2.5-coder:7b
OPENCODE_MODEL_URL=http://host.docker.internal:11434

# For the Streamiov Cloudflare AI gateway, use:
# OPENCODE_MODEL_PROVIDER=cloudflare-workers-ai
# OPENCODE_MODEL=@cf/zai-org/glm-4.7-flash
# OPENCODE_MODEL_URL=https://YOUR-WORKER.workers.dev
# OPENCODE_AI_WORKER_TOKEN=replace-with-your-own-token

# Optional fallback provider (must have its own access and quota).
# OPENCODE_FALLBACK_PROVIDER=openai-compatible-local
# OPENCODE_FALLBACK_MODEL=your-fallback-model
# OPENCODE_FALLBACK_MODEL_URL=http://host.docker.internal:8001/v1

from __future__ import annotations

from datetime import datetime, timezone
from pathlib import Path
import json
import uuid

from ai.runtime.executor import create_executor


BASE = Path(__file__).resolve().parents[2]
WISH_DIR = BASE / "ai" / "runtime" / "wishes"

executor = create_executor()


def now():
    return datetime.now(timezone.utc).isoformat()


def submit_wish(request: str, source: str = "homepage"):
    request = (request or "").strip()

    if not request:
        raise ValueError("request_required")

    wish_id = "wish-" + uuid.uuid4().hex[:16]

    result = executor.execute(request)

    record = {
        "wish_id": wish_id,
        "created_at": now(),
        "source": source,
        "request": request,
        "result": result.as_dict(),
    }

    path = WISH_DIR / f"{wish_id}.json"
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(
        json.dumps(record, ensure_ascii=False, indent=2),
        encoding="utf-8",
    )

    return record

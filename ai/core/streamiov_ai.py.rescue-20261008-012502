from __future__ import annotations

from dataclasses import dataclass, field
from datetime import datetime, timezone
from pathlib import Path
import json
import re
from typing import Any


BASE = Path(__file__).resolve().parents[2]
KNOWLEDGE = BASE / "ai" / "knowledge"
POLICIES = BASE / "ai" / "policies"


@dataclass
class AIResult:
    category: str
    action: str
    allowed: bool
    approval_required: bool
    reason: str
    plan: list[str] = field(default_factory=list)

    def as_dict(self) -> dict[str, Any]:
        return {
            "category": self.category,
            "action": self.action,
            "allowed": self.allowed,
            "approval_required": self.approval_required,
            "reason": self.reason,
            "plan": self.plan,
        }


class StreamiovAI:
    def __init__(self) -> None:
        self.mission = self._load("streamiov_ai_mission.json")
        self.masterplan = self._load("masterplan_ai.json")
        self.boundaries = self._load("ai_boundaries.json")

    @staticmethod
    def _load(filename: str) -> dict[str, Any]:
        path = (
            KNOWLEDGE / filename
            if filename != "ai_boundaries.json"
            else POLICIES / filename
        )
        with path.open("r", encoding="utf-8") as fh:
            return json.load(fh)

    def classify(self, request: str) -> str:
        text = request.lower()

        if any(x in text for x in (
            "passwort", "ownerrechte", "auth", "sicherheit",
            "kern", "datenbankschema", "secret", "credential"
        )):
            return "protected"

        if any(x in text for x in (
            "spiel", "game", "eigenes spiel"
        )):
            return "game"

        if any(x in text for x in (
            "geschenk", "gift"
        )):
            return "gift"

        if any(x in text for x in (
            "event", "ereignis"
        )):
            return "event"

        if any(x in text for x in (
            "tts", "text to speech", "sprache"
        )):
            return "tts"

        if any(x in text for x in (
            "sound", "ton", "audio"
        )):
            return "sound"

        if any(x in text for x in (
            "musik", "music"
        )):
            return "music"

        if any(x in text for x in (
            "fehler", "diagnose", "problem"
        )):
            return "diagnostics"

        if any(x in text for x in (
            "test", "prüf", "testen"
        )):
            return "testing"

        return "wunschbox"

    def analyze(self, request: str) -> AIResult:
        request = request.strip()

        if not request:
            return AIResult(
                category="invalid",
                action="none",
                allowed=False,
                approval_required=False,
                reason="Leerer Auftrag",
            )

        category = self.classify(request)

        if category == "protected":
            return AIResult(
                category=category,
                action="approval_request",
                allowed=False,
                approval_required=True,
                reason="Der Auftrag betrifft einen geschützten Bereich.",
                plan=[
                    "Auftrag dokumentieren",
                    "Änderung fachlich prüfen",
                    "Freigabe beim Owner anfordern",
                    "Erst nach Freigabe ausführen",
                    "Ergebnis anschließend testen",
                ],
            )

        plans = {
            "game": [
                "Spielauftrag analysieren",
                "Spielkonzept erstellen",
                "benötigte Module bestimmen",
                "Spiel innerhalb des vorgesehenen Bereichs erzeugen",
                "automatische Tests durchführen",
                "Version dokumentieren",
                "bei Freigabe als Download vorbereiten",
            ],
            "gift": [
                "Geschenkauftrag analysieren",
                "Geschenkdefinition erstellen",
                "zugehörige Action bestimmen",
                "Konfiguration testen",
            ],
            "event": [
                "Eventauftrag analysieren",
                "Eventdefinition erstellen",
                "Trigger und Actions bestimmen",
                "Konfiguration testen",
            ],
            "tts": [
                "TTS-Auftrag analysieren",
                "TTS-Aktion definieren",
                "Einstellungen prüfen",
                "Test durchführen",
            ],
            "sound": [
                "Soundauftrag analysieren",
                "Sound-Aktion vorbereiten",
                "Kompatibilität prüfen",
                "Test durchführen",
            ],
            "music": [
                "Musikauftrag analysieren",
                "Regeln und Rechte prüfen",
                "Liste aktualisieren oder Prüfbericht erstellen",
                "Ergebnis testen",
            ],
            "diagnostics": [
                "Fehlerbeschreibung analysieren",
                "betroffene Komponente bestimmen",
                "Diagnose durchführen",
                "Lösung vorbereiten",
                "Änderung nur im erlaubten Bereich ausführen",
                "anschließend testen",
            ],
            "testing": [
                "Testauftrag analysieren",
                "geeigneten Test bestimmen",
                "Test ausführen",
                "Ergebnis dokumentieren",
            ],
            "wunschbox": [
                "Wunsch analysieren",
                "passende Streamiov-Funktion bestimmen",
                "Auftrag in konkrete Schritte zerlegen",
                "Berechtigung prüfen",
                "Aufgabe ausführen oder Freigabe anfordern",
            ],
        }

        return AIResult(
            category=category,
            action="execute_or_prepare",
            allowed=True,
            approval_required=False,
            reason="Auftrag liegt innerhalb des definierten KI-Bereichs.",
            plan=plans.get(category, plans["wunschbox"]),
        )

    def status(self) -> dict[str, Any]:
        return {
            "project": "Streamiov",
            "component": "AI Core",
            "status": "implemented",
            "verified": True,
            "knowledge_loaded": bool(self.mission and self.masterplan),
            "boundaries_loaded": bool(self.boundaries),
            "timestamp": datetime.now(timezone.utc).isoformat(),
        }


def create_ai() -> StreamiovAI:
    return StreamiovAI()


def main() -> int:
    import argparse

    parser = argparse.ArgumentParser(
        description="Streamiov AI – kontrollierter lokaler Arbeitslauf"
    )
    parser.add_argument("--mode", default="controlled")
    parser.add_argument("--task", default="status")
    parser.add_argument("--apple-audit", action="store_true", help="Nur lokalen Apple/iOS/macOS/Web-App-Audit ausführen")
    parser.add_argument("--no-production-changes", action="store_true")
    parser.add_argument("--no-server-restart", action="store_true")
    parser.add_argument("--no-external-connections", action="store_true")
    parser.add_argument("--no-credentials", action="store_true")
    parser.add_argument("--no-platform-auth", action="store_true")
    args = parser.parse_args()

    ai = create_ai()

    print("==================================================")
    print(" STREAMIOV AI – CONTROLLED WORKER")
    print("==================================================")
    print(f"MODE: {args.mode}")

    if args.apple_audit:
        from pathlib import Path
        import re

        root = Path(__file__).resolve().parents[2]
        web = root / "app" / "web"
        downloads = web / "downloads"
        apple = downloads / "apple"

        print("\n==================================================")
        print(" STREAMIOV – APPLE / iOS / macOS LOCAL AUDIT")
        print("==================================================")
        print("SCOPE: lokale Dateien + Web-App")
        print("PRODUCTION CHANGES: DISABLED")
        print("SERVER RESTART: DISABLED")
        print("EXTERNAL CONNECTIONS: DISABLED")
        print("CREDENTIALS: DISABLED")
        print("PLATFORM AUTH: DISABLED")

        ok = []
        open_items = []
        errors = []

        def check(label, condition, detail=""):
            if condition:
                ok.append(label)
                print(f"[OK] {label}" + (f" — {detail}" if detail else ""))
            else:
                open_items.append(label)
                print(f"[OFFEN] {label}" + (f" — {detail}" if detail else ""))

        print("\n=== 1. VERZEICHNISSE ===")
        check("Web-App vorhanden", web.is_dir(), str(web))
        check("Downloads vorhanden", downloads.is_dir(), str(downloads))
        check("Apple-Verzeichnis vorhanden", apple.is_dir(), str(apple))

        print("\n=== 2. NATIVES iOS / XCODE ===")
        native = []
        for pattern in ("*.xcodeproj", "*.xcworkspace", "Package.swift", "*.swift"):
            native.extend(root.rglob(pattern))
        native = [x for x in native if "backup" not in x.parts and "backups" not in x.parts]
        if native:
            check("Natives Apple-Projekt gefunden", True, ", ".join(str(x.relative_to(root)) for x in native[:20]))
        else:
            print("[OFFEN] Kein natives Xcode/Swift-Projekt vorhanden")
            open_items.append("Natives iOS-Projekt nicht vorhanden")
            print("[INFO] Auf Chromebook kein natives iOS-Build als verifiziert markieren.")

        print("\n=== 3. APPLE DOWNLOADS ===")
        candidates = [
            downloads / "streamiov-macos.dmg",
            downloads / "streamiov-android.apk",
            downloads / "streamiov-linux.tar.gz",
            downloads / "streamiov-windows-setup.exe",
            downloads / "streamiov-server.zip",
        ]
        for f in candidates:
            if not f.exists():
                print(f"[OFFEN] Datei fehlt: {f.relative_to(root)}")
                open_items.append(f"Fehlender Download: {f.name}")
            elif f.stat().st_size == 0:
                print(f"[OFFEN] 0-Byte-Datei: {f.relative_to(root)}")
                open_items.append(f"Platzhalter/0-Byte: {f.name}")
            else:
                print(f"[OK] Echter Dateiinhalte vorhanden: {f.relative_to(root)} ({f.stat().st_size} Bytes)")
                ok.append(f.name)

        print("\n=== 4. WEB-APP / APPLE-HINWEISE ===")
        html_files = list(web.rglob("*.html")) if web.exists() else []
        check("HTML-Dateien vorhanden", bool(html_files), f"{len(html_files)} Dateien")

        apple_terms = re.compile(r"Apple|iOS|iPhone|iPad|macOS|Safari|App Store|IPA|Xcode", re.I)
        matches = []
        for f in html_files:
            try:
                text = f.read_text(errors="ignore")
            except Exception as e:
                errors.append(f"{f}: {e}")
                continue
            if apple_terms.search(text):
                matches.append(f.relative_to(root))

        if matches:
            print(f"[OK] Apple-/iOS-/macOS-Hinweise gefunden: {len(matches)} Dateien")
            for x in matches[:30]:
                print(f"     {x}")
        else:
            print("[OFFEN] Keine Apple-Hinweise in der Web-App gefunden")
            open_items.append("Apple-Hinweise fehlen")

        print("\n=== 5. WEB-APP FUNKTIONSMARKER ===")
        index = web / "index.html"
        info = web / "info" / "index.html"
        studio = web / "studio" / "index.html"
        wish = web / "wunschbox" / "index.html"

        for name, f in [
            ("Homepage", index),
            ("Info", info),
            ("Studio", studio),
            ("Wunschbox", wish),
        ]:
            check(name, f.exists(), str(f.relative_to(root)))

        if index.exists():
            text = index.read_text(errors="ignore")
            check("HTTPS-Ziel vorhanden", "https://" in text)
            check("Kamera-/Mikrofon-Bezug vorhanden",
                  bool(re.search(r"camera|microphone|kamera|mikrofon|mediaDevices|getUserMedia", text, re.I)))

        print("\n=== 6. DOWNLOAD-LINKS ===")
        for f in html_files:
            try:
                text = f.read_text(errors="ignore")
            except Exception:
                continue
            for target in re.findall(r'href=["\\']([^"\\']+)["\\']', text, re.I):
                if any(x in target.lower() for x in ("macos", "apple", "ios", "android", "linux", "windows")):
                    print(f"[LINK] {f.relative_to(root)} -> {target}")

        print("\n=== 7. ABSCHLUSS ===")
        print("APPLE/iOS STATUS")
        print(f"[OK] Lokaler Audit ausgeführt: {len(ok)}")
        print(f"[OFFEN] Echte offene Punkte: {len(open_items)}")
        print(f"[FEHLER] Audit-Fehler: {len(errors)}")

        print("\nWEB-APP:")
        print("[GETESTET] Lokale HTML-/Dateistruktur geprüft.")

        print("\nNATIVES iOS:")
        if native:
            print("[GETESTET] Native Apple-Projektdateien gefunden.")
        else:
            print("[NICHT VERIFIZIERT] Kein natives Xcode/Swift-Projekt auf diesem Chromebook.")

        print("\nmacOS:")
        dmg = downloads / "streamiov-macos.dmg"
        if dmg.exists() and dmg.stat().st_size > 0:
            print("[GETESTET] macOS-Datei enthält Daten.")
        else:
            print("[OFFEN] macOS-DMG ist nicht als fertiger Download verifiziert.")

        print("\nDOWNLOADS:")
        for x in open_items:
            if "Download" in x or "0-Byte" in x or "Platzhalter" in x:
                print(f"[OFFEN] {x}")

        print("\nECHTE OFFENE PUNKTE:")
        for x in open_items:
            print(f"- {x}")
        if not open_items:
            print("[OK] Keine lokalen offenen Punkte gefunden.")

        print("\nNICHT ERFUNDEN / NICHT VERIFIZIERT:")
        print("- Kein natives iOS-Build auf Chromebook behauptet.")
        print("- Keine IPA erfunden.")
        print("- Safari/Kamera/Mikrofon auf echter Apple-Hardware nicht als vollständig verifiziert ausgegeben.")
        print("- Keine Production-, Server-, Cloud-, DNS-, Account- oder Sicherheitsänderungen durchgeführt.")

        print("\n==================================================")
        print(" APPLE LOCAL AUDIT ENDE")
        print("==================================================")
        raise SystemExit(0)

    print(f"TASK: {args.task}")
    print("PRODUCTION CHANGES: DISABLED")
    print("SERVER RESTART: DISABLED")
    print("EXTERNAL CONNECTIONS: DISABLED")
    print("CREDENTIALS: DISABLED")
    print("PLATFORM AUTH: DISABLED")
    print()

    result = ai.analyze(args.task)

    print(">>> ANALYSE")
    print(json.dumps(result.as_dict(), indent=2, ensure_ascii=False))

    print()
    print(">>> AI STATUS")
    print(json.dumps(ai.status(), indent=2, ensure_ascii=False))

    print()
    print("STATUS: ANALYSIS_COMPLETE")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())

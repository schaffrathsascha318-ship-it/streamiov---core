    """Normalisierte Strukturprüfung; kein echter Bildvergleich."""
    svg = re.sub(r"<!--.*?-->", "", svg, flags=re.DOTALL)
    svg = re.sub(r"<title\b[^>]*>.*?</title>", "", svg,
                 flags=re.IGNORECASE | re.DOTALL)
    svg = re.sub(r"<desc\b[^>]*>.*?</desc>", "", svg,
                 flags=re.IGNORECASE | re.DOTALL)

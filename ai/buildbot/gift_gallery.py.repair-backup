#!/usr/bin/env python3
"""Streamiov Gift Gallery: sichere interne Aufnahme neuer SVG-Entwürfe."""

import argparse
import hashlib
import json
import re
import shutil
from datetime import datetime, timezone
from pathlib import Path

ROOT = Path(__file__).resolve().parents[2]
CATALOG = ROOT / "config/gifts/catalog.json"
ASSETS = ROOT / "public/assets/gifts"
DRAFTS = ROOT / "data/gift-gallery/drafts"
MANIFEST = DRAFTS / "manifest.json"


def sha256(data):
    return hashlib.sha256(data).hexdigest()



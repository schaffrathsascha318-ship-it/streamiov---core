**/.env*
**/.wrangler/
**/node_modules/
**/__pycache__/
**/*.pyc
**/.gradle/
**/build/
**/local.properties
**/data/oauth/
**/*token*.json
**/*.sqlite*
**/*.log
**/backups/
**/backup-*/
**/*-backup-*/
**/*.backup*
**/*.bak*
**/*.save*
**/*.before*
**/*.vor-*
**/*.tar
**/*.tar.gz
**/*.zip
# Audited game release candidates are small artifacts named by their manifests.
!games/releases/*.zip
# The public download hub mirrors those small, checksummed prototypes so the
# static site and the self-hosted site can serve the same files.
!dist/streamiov-homepage-worker/public/downloads/*.zip
.venv/
dist/streamiov-studio-app/electron
dist/streamiov-studio-app/streamiov-studio@1.0.0

# Alte Sicherungs- und generierte Projektstände
**/backup-*/
**/backups/
**/backups-*/
**/*-backup-*/
**/dist/candidates/

/backup/

# Alte Studio-Sicherungen und Diagnose-Dateien
dist/streamiov-studio-app/backup-*/
dist/streamiov-studio-app/**/*-backup-*/
dist/streamiov-studio-app/**/*.bak
dist/streamiov-studio-app/**/*.bak-*
dist/streamiov-studio-app/**/*.before-*
dist/streamiov-studio-app/**/*.before_*
dist/streamiov-studio-app/**/diagnose-*.cjs

/android/backup/

# Sensitive local credentials and private configuration (never commit)
/secrets/
/.en
/.envy
/config/platforms/**/oauth*.json
/config/**/*.secret.*
/config/**/*credentials*

# Locally built installers and generated module backups
/dist/streamiov-studio-app/release/
/dist/streamiov-homepage/account/
/dist/streamiov-homepage/assets/
/modules/**/*.bak
/modules/**/*.bak-*
/modules/**/*.save
/modules/**/*.before-*

# Release signing private key — must never be committed
/release-signing.key
**/release-signing.key

# Runtime state, private request data and historical deployment logs
/.testdir/
/logs/
/storage/
*.pid
